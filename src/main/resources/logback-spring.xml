<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="local,dev">
        <evaluator name="ON_ERROR" class="ch.qos.logback.classic.boolex.OnErrorEvaluator"/>
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level %logger{1}: requestId=%X{requestId} user=%X{userId} name=%X{displayName} - %msg%n%caller{1, ON_ERROR}%rEx{10}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!local &amp; !dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <timeZone>UTC</timeZone>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>