	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"const url = String(pm.response.url)",
					"const isNotRefreshTokenUrl = !url.includes(\"/auth/refresh_token\")",
					"if (pm.response.code === 401 && isNotRefreshTokenUrl) {",
					"    console.log(\"Access token expired. Refreshing...\");",
					"    const baseUrl = pm.environment.get(\"backend_url\")",
					"    const harmony_refresh_token = pm.environment.get(\"refresh_token\");",
					"    pm.sendRequest({",
					"        url: baseUrl + \"/auth/refresh_token\",",
					"        method: \"POST\",",
					"        header: {",
					"            \"Content-Type\": \"application/json\",",
					"            \"Cookie\":`harmony_refresh_token=${harmony_refresh_token}`",
					"        }",
					"    }, (err, res) => {",
					"        if (!err && res.json().harmony_access_token) {",
					"            const access_token = res.json().harmony_access_token",
					"            console.log(\"setting new access token: \"+ access_token);",
					"            pm.environment.set(\"access_token\", access_token);",
					"",
					"            const refreshTokenCookie = pm.cookies.get(\"harmony_refresh_token\");",
					"            console.log(\"setting new refresh token: \"+ refreshTokenCookie);",
					"            pm.environment.set(\"refresh_token\", refreshTokenCookie);",
					"        }",
					"    });",
					"}"
				]
			}
		}
