		{
			"name": "/auth/refresh_token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"updating tokens\", () => {",
							"    var response = pm.response.json();",
							"    var harmonyAccessToken = response.harmony_access_token;",
							"",
							"    console.log(\"setting new access token: \"+ harmonyAccessToken);",
							"    pm.environment.set(\"access_token\", harmonyAccessToken);",
							"",
							"    ",
							"    var refreshTokenCookie = pm.cookies.get(\"harmony_refresh_token\");",
							"",
							"    console.log(\"setting new refresh token: \"+ refreshTokenCookie);",
							"    pm.environment.set(\"refresh_token\", refreshTokenCookie);",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Cookie",
						"value": "harmony_refresh_token={{refresh_token}}",
						"type": "text"
					}
				],
				"url": {
